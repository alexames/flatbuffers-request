// Exercises every FlatBuffer kind (scalar, struct, string, union, nested table, and vector variants) so FlatbufferRequest round-tripping has full type coverage.

namespace matcher_test;

table Integer {
  value: int32;
}

table FloatingPoint {
  value: float32;
}

// Two fields, which is what makes a put into a stored member observable: a
// request naming one of them must leave the other as it was.
table Fraction {
  numerator: int32;
  denominator: int32;
}

// Appended, so the enum indices the golden files carry do not shift.
union Number {
  Integer,
  FloatingPoint,
  Fraction
}

// An enum-typed scalar. Its reflection Type carries an `index` naming the
// enum, exactly as a table's Type carries one naming the object, so a parser
// deciding "is this a table" from `index` alone mistakes one for the other.
// Non-contiguous on purpose: an ordinal that equals its position would hide a
// parser writing positions instead of values.
enum Color : ubyte {
  Red,
  Green = 4,
  Blue,
}

struct ScalarStruct {
  b: bool;
  i8: int8;
  ui8: uint8;
  i16: int16;
  ui16: uint16;
  i32: int32;
  ui32: uint32;
  i64: int64;
  ui64: uint64;
  f32: float32;
  f64: float64;

  i32_array: [int32:10];
}

// A struct inside a struct, and an array whose elements are structs: the
// first is written member by member, the second is not written at all.
struct Inner {
  a: int8;
  arr: [int16:3];
}

struct Nested {
  inner: Inner;
  structs: [Inner:2];
  tail: int32;
}

table TestSchema {
  b: bool;
  i8: int8;
  ui8: uint8;
  i16: int16;
  ui16: uint16;
  i32: int32;
  ui32: uint32;
  i64: int64;
  ui64: uint64;
  f32: float32;
  f64: float64;

  string: string;
  // Self-referential here (and as object_vector below) so recursive tables get exercised during round-trip.
  object: TestSchema;
  number: Number;
  scalars: ScalarStruct;

  b_vector: [bool];
  i8_vector: [int8];
  ui8_vector: [uint8];
  i16_vector: [int16];
  ui16_vector: [uint16];
  i32_vector: [int32];
  ui32_vector: [uint32];
  i64_vector: [int64];
  ui64_vector: [uint64];
  f32_vector: [float32];
  f64_vector: [float64];

  string_vector: [string];
  object_vector: [TestSchema];
  number_vector: [Number];
  struct_vector: [ScalarStruct];

  // Appended, so the vtable slots the golden buffers were built with do not
  // shift.
  color: Color;
  color_vector: [Color];
  nested: Nested;
}

root_type TestSchema;